<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Same reasoning as CrimeEmpire.Simulation.csproj: the Godot .NET 8 host and the .NET 10
      test/runner host both need to load this, and multi-targeting is a packaging fact about which
      runtime can load it, not a coupling to either. See AGENTS.md "Repository boundaries" and
      milestone 015 ruling 3 — SQLite and filesystem concerns live here precisely so
      CrimeEmpire.Simulation never has to know they exist.
    -->
    <TargetFrameworks>$(CrimeEmpireEngineTfm);$(CrimeEmpireHostTfm)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrimeEmpire.Simulation\CrimeEmpire.Simulation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Mirrors CrimeEmpire.Simulation's own grant: tests need to reach the reconstructed
      SimulationSession (and, through its own internal accessor, World) to prove exact internal
      replay-state identity. Nothing else — not Godot, not the Runner — gets this.
    -->
    <InternalsVisibleTo Include="CrimeEmpire.Simulation.Tests" />
  </ItemGroup>
</Project>
