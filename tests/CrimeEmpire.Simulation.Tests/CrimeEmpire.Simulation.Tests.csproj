<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Selected from Directory.Build.props rather than spelled out. Carried since milestone 002 as a
      redundant override of a centralised assignment; milestone 009 removed that assignment (see
      DESIGN_DECISIONS.md §Stack), so every project now names the framework it wants and this line
      stopped being redundant rather than being tidied away.
    -->
    <TargetFramework>$(CrimeEmpireHostTfm)</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CrimeEmpire.Simulation\CrimeEmpire.Simulation.csproj" />
    <!--
      The player-facing renderer lives in the Runner because console formatting is deliberately
      kept out of the simulation library (AGENTS.md, "Repository boundaries"). The no-leak test
      has to exercise the real renderer rather than a copy of it, so the tests reach into the
      Runner for that one type.
    -->
    <ProjectReference Include="..\..\src\CrimeEmpire.Runner\CrimeEmpire.Runner.csproj" />
  </ItemGroup>

</Project>
